{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/web/index.html"
    },
    {
      "source": "/scanner.html",
      "destination": "/web/scanner.html"
    },
    {
      "source": "/agent-guard.html",
      "destination": "/web/agent-guard.html"
    },
    {
      "source": "/faqs.html",
      "destination": "/web/faqs.html"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/theme.js",
      "destination": "/web/theme.js"
    },
    {
      "source": "/vision.js",
      "destination": "/web/vision.js"
    },
    {
      "source": "/style.css",
      "destination": "/web/style.css"
    },
    {
      "source": "/dossier.css",
      "destination": "/web/dossier.css"
    },
    {
      "source": "/verification.css",
      "destination": "/web/verification.css"
    },
    {
      "source": "/vision.css",
      "destination": "/web/vision.css"
    },
    {
      "source": "/favicon.svg",
      "destination": "/web/favicon.svg"
    },
    {
      "source": "/vigil-logo.png",
      "destination": "/web/vigil-logo.png"
    },
    {
      "source": "/vigil-logo-transparent.png",
      "destination": "/web/vigil-logo-transparent.png"
    },
    {
      "source": "/telegram-qr.png",
      "destination": "/web/telegram-qr.png"
    },
    {
      "source": "/demo-agent-page",
      "destination": "/web/demo-agent-page.html"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/web/vendor/:path*"
    },
    {
      "source": "/api/vision/analyze",
      "destination": "/api/vision-analyze"
    }
  ]
}
